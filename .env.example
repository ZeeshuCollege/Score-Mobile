# ==========================================
# SCORE - Supabase & Auth Environment Config
# ==========================================

# 1. Supabase Project URL
# Location: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anon Key (Public Key)
# Location: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> "anon public"
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# 3. (Optional) Google OAuth Web Client ID
# Location: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
GOOGLE_WEB_CLIENT_ID=your-client-id.apps.googleusercontent.com


# ==========================================
# Cloudflare R2 Configuration
# ==========================================
# Cloudflare Account ID (find in Cloudflare Dashboard → R2 Object Storage)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# R2 API Token Access Key ID (generate at: Cloudflare Dashboard → R2 → Manage R2 API Tokens)
R2_ACCESS_KEY_ID=your-r2-access-key-id

# R2 API Token Secret Access Key
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# R2 Public Bucket Name (for question images, diagrams, educational PDFs)
R2_BUCKET_PUBLIC=score-public-assets

# R2 Private Bucket Name (for user-uploaded documents)
R2_BUCKET_PRIVATE=score-private-uploads

# R2 S3-compatible endpoint (format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Custom CDN domain connected to public R2 bucket (after Cloudflare setup)
R2_PUBLIC_DOMAIN=https://cdn.your-domain.com

# ==========================================
# Firebase Cloud Messaging Configuration
# ==========================================
# Firebase Project ID (find in Firebase Console → Project Settings → General)
FIREBASE_PROJECT_ID=your-firebase-project-id

# IMPORTANT: FIREBASE_SERVICE_ACCOUNT_JSON must be stored ONLY in Supabase Edge Function secrets
# NEVER store it in .env, Flutter code, or version control
# Set it via: supabase secrets set FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
