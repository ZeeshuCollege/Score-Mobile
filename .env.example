# ==========================================
# SCORE - Supabase & Auth Environment Config
# ==========================================

# 1. Supabase Project URL
# Location: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anon Key (Public Key)
# Location: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> "anon public"
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# 3. (Optional) Google OAuth Web Client ID
# Location: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
GOOGLE_WEB_CLIENT_ID=your-client-id.apps.googleusercontent.com
